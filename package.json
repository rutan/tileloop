{
  "name": "tileloop",
  "private": true,
  "author": "rutan <ru_shalm@hazimu.com>",
  "scripts": {
    "start": "vite preview",
    "dev": "vite",
    "build": "run-s build:*",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build:prerender": "node scripts/prerender.mjs",
    "lint": "run-s lint:*",
    "lint:prettier": "oxfmt --check",
    "lint:oxlint": "oxlint",
    "lint:tsgo": "tsgo --noEmit",
    "format": "oxfmt",
    "deploy": "run-s build deploy:*",
    "deploy:wrangler": "wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^1.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ress": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript/native-preview": "7.0.0-dev.20260512.1",
    "@vitejs/plugin-react": "^6.0.3",
    "npm-run-all2": "^8.0.4",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.22.1",
    "vite": "^8.1.0",
    "wrangler": "^4.104.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.1"
}
